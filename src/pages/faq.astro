---
// FAQ — the homepage FAQ as its own page (Nov 2026). The footer's "FAQ"
// link lands here. It renders the SAME Faq component as the homepage, so
// the questions, answers, links and styling have one source and can't drift
// apart (the previous page kept its own copy from May and went stale).
//
// Edit FAQ copy in src/components/founders/Faq.astro, never here.
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/founders/Nav.astro';
import Faq from '@/components/founders/Faq.astro';
import Closing from '@/components/founders/Closing.astro';
---

<Layout
  title="FAQ — Stand"
  description="Answers to the questions parents ask most about STAND: where we are, who it's for, what kids learn, when it starts, and our cancellation policy."
>
  <main class="founders-page">
    <Nav
      tabs={[
        { label: 'Home', href: '/' },
        { label: 'About', href: '/about' },
      ]}
    />
    {/* data-nav-cream: this wrapper starts at the very top, under the fixed
        nav, so the nav flips to its red state from the first paint instead
        of sitting cream-on-cream until the FAQ section scrolls up to it. */}
    <div class="faq-wrap" data-nav-cream>
      <Faq level={1} />
    </div>
    <Closing />
  </main>
</Layout>

<style>
  /* The nav is fixed, so push the FAQ down by the bar's height. The section
     keeps its own top padding on top of that. */
  .faq-wrap {
    padding-top: var(--header-h);
  }
</style>
