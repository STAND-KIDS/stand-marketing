---
// Location — the launch section: heavy announcement + lede + CTA in the
// left rail; the eight-week story runs down the right column.
// Chunks use the page-level data-rv reveal (armed by the index script).
//
// Nov 2026 (January launch copy): Santa Monica, opening Jan 11, 2027. The
// week-by-week table is gone — the new copy tells the eight weeks as one
// paragraph. Both CTAs are "Enroll now" to Sawyer (ENROLL_HREF); the second
// sits at the end of the story so a reader who just finished it doesn't have
// to scroll back up to the rail.
import SignupButton from './SignupButton.astro';
import { ENROLL_HREF } from '@/data/enroll';
---

<section class="fc-location" id="location" aria-labelledby="location-title">
  <div class="grid">
    <header class="rail">
      <h2 id="location-title" data-rv style="--rvi: 0">
        STAND is opening in Santa&nbsp;Monica!
      </h2>
      <p class="lede" data-rv style="--rvi: 1">
        We&rsquo;re so excited to open the doors to our very first space on
        January&nbsp;11,&nbsp;2027.
      </p>
      <div class="cta" data-rv style="--rvi: 2">
        <SignupButton label="Enroll now" href={ENROLL_HREF} />
      </div>
    </header>

    <div class="detail">
      <p class="intro" data-rv style="--rvi: 3">
        Over eight weeks, kids ages 8 to 13 come up with an idea they care
        about, then design it, create it, and turn it into something real.
      </p>

      <p class="para" data-rv style="--rvi: 4">
        At the end, they share what they made at Pitch Night, a showcase in
        front of family and friends.
      </p>

      <p class="para" data-rv style="--rvi: 5">
        Along the way, they get hands-on mentorship, make new friends, and
        build alongside other kids.
      </p>

      <p class="para" data-rv style="--rvi: 6">
        Because some things you only learn by doing.
      </p>

      <div class="cta cta-end" data-rv style="--rvi: 7">
        <SignupButton label="Enroll now" href={ENROLL_HREF} />
      </div>
    </div>
  </div>
</section>

<style>
  .fc-location {
    background: var(--stand-cream);
    color: var(--stand-black);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 5vw, 72px);
    max-width: calc(1132px + 2 * 48px);
    margin: 0 auto;
    padding: clamp(56px, 6.1vw, 88px) 48px clamp(56px, 6.3vw, 90px);
  }

  .rail {
    position: sticky;
    top: 96px;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 1.7vw, 24px);
  }

  /* Editorial New Light, matching the About mega (Proto B won the Aug 25
     A/B review) — cased as written, no transform. */
  h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(32px, 3.8vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.01em;
    text-transform: none;
  }

  .lede {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(18px, 1.8vw, 26px);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--stand-black);
  }

  .cta :global(.signup) {
    min-width: 0;
    align-self: flex-start;
  }

  .cta-end {
    margin-top: clamp(28px, 3vw, 44px);
  }

  .detail {
    display: flex;
    flex-direction: column;
  }

  .intro,
  .para {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(17px, 1.8vw, 24px);
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .para {
    margin-top: clamp(18px, 2vw, 28px);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      padding-left: 20px;
      padding-right: 20px;
    }

    .rail {
      position: static;
    }
  }
</style>
