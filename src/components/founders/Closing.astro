---
// Closing enrollment CTA — red ground, big cream stand wordmark, paper-tag
// sign-up, scarcity line, and the Instagram / TikTok marks as the page's
// sign-off (this section doubles as the footer). The wordmark replaced the "Build your own thing.
// For Real." headline (Aug 20 review: the kid-moment section already says
// it, and cream-on-red avoids the red/yellow pairing). Wordmark is logo.svg
// as a CSS mask, same technique as the nav and manifesto.
// Aug 25 (Proto B promoted): the general-interest email bar sits in the
// footer, wordmark left / bar right, ruled sign-off row underneath.
// Nov 2026: the sign-off row became labelled link columns (Explore /
// Contact / Fine Print), modelled on forgemakerspace.com's footer. Fine
// Print reads src/data/fine-print.ts; drafts stay hidden until published.
import SubscribeBar from './SubscribeBar.astro';
import { FINE_PRINT } from '@/data/fine-print';

interface FooterColumn {
  label: string;
  links: { label: string; href: string }[];
}

// Each column is just data; the grid below lays out however many there are.
// A column whose links are all unpublished drops out instead of showing an
// empty heading.
const columns: FooterColumn[] = [
  {
    label: 'Explore',
    // About lives here on purpose: Nav.astro hides its tabs below 1024px, so
    // on phones and tablets this is the only route to /about.
    links: [
      { label: 'Home', href: '/' },
      { label: 'About', href: '/about' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  {
    label: 'Contact',
    links: [
      { label: 'hello@standkids.com', href: 'mailto:hello@standkids.com' },
      { label: 'Instagram', href: 'https://www.instagram.com/buildwithstand' },
      { label: 'TikTok', href: 'https://www.tiktok.com/@buildwithstand' },
    ],
  },
  {
    label: 'Fine Print',
    links: FINE_PRINT.filter((link) => link.published),
  },
].filter((col) => col.links.length > 0);
---

<section class="fc-closing" aria-label="Sign up">
  <div class="cols">
    <div class="wordmark" role="img" aria-label="stand" data-rv style="--rvi: 0"></div>
    <div class="cta-wrap" data-rv style="--rvi: 1">
      <SubscribeBar />
    </div>
  </div>
  <!-- Full-bleed rule (JY, Aug 25), then the link columns on the same
       content width and gutters as the capture row above. -->
  <hr class="rule" aria-hidden="true" />
  <nav class="link-cols" aria-label="Footer" data-rv style="--rvi: 2">
    {
      columns.map((col, i) => (
        <div class="link-col">
          <h2 id={`footer-col-${i}`}>{col.label}</h2>
          <ul aria-labelledby={`footer-col-${i}`}>
            {col.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </nav>
</section>

<style>
  .fc-closing {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-3);
    /* Tight top/bottom — the band sits at ~2/3 of its old height. */
    padding: var(--space-6) var(--space-3) var(--space-3);
    background: var(--stand-red);
    color: var(--stand-cream);
  }

  /* Two columns on the page's content width — wordmark left, email
     capture right. */
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
    width: 100%;
    max-width: calc(1132px + 2 * 48px);
    margin-inline: auto;
    padding-inline: 48px;
    text-align: left;
  }

  .wordmark {
    width: min(400px, 100%);
    aspect-ratio: 199.29 / 47.33;
    background: var(--stand-cream);
    -webkit-mask: url('/brand/logo.svg') no-repeat left center / contain;
    mask: url('/brand/logo.svg') no-repeat left center / contain;
  }

  .cta-wrap {
    display: flex;
    justify-content: flex-end;
    min-width: 0;
  }

  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: var(--space-3);
      padding-inline: 20px;
      text-align: center;
    }

    .wordmark {
      width: min(520px, 70%);
      -webkit-mask-position: center;
      mask-position: center;
    }
  }

  /* Full-bleed hairline — negative margins escape the section's side
     padding so the rule runs edge to edge (JY, Aug 25). */
  .rule {
    width: calc(100% + 2 * var(--space-3));
    margin: var(--space-2) calc(-1 * var(--space-3)) 0;
    border: 0;
    border-top: 1px solid color-mix(in srgb, var(--stand-cream) 35%, transparent);
  }

  /* Link columns (Forge-style). auto-fit + minmax lets the grid choose
     its own column count from the space it has: three across on desktop,
     two on a tablet, and no media query needed to get there. Empty tracks
     collapse, so three columns always share the full width. */
  .link-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4) 32px;
    width: 100%;
    max-width: calc(1132px + 2 * 48px);
    margin: 0 auto;
    padding: var(--space-2) 48px var(--space-3);
    text-align: left;
  }

  .link-col h2 {
    margin: 0 0 var(--space-1);
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 15px;
    color: color-mix(in srgb, var(--stand-cream) 65%, transparent);
  }

  .link-col ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 44px rows double as tap targets. */
  .link-col a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 19px;
    color: var(--stand-cream);
    text-underline-offset: 4px;
  }

  .link-col a:hover,
  .link-col a:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  @media (max-width: 768px) {
    .fc-closing {
      padding: var(--space-5) var(--space-3) var(--space-2);
    }

    .link-cols {
      padding-inline: 20px;
    }
  }

  /* Phones: one column, centered under the centered wordmark and bar. */
  @media (max-width: 600px) {
    .link-cols {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      text-align: center;
    }
  }
</style>
