---
// Parent FAQ — native <details>/<summary> accordion (zero JS, keyboard
// accessible for free). Copy: January launch homepage copy, Nov 2026.
//
// Answers are HTML strings (rendered with set:html) so a few can carry
// links. That is only safe because every string here is written by us in
// this file. Never feed visitor- or API-supplied text into this list.
import { ENROLL_HREF } from '@/data/enroll';

interface Props {
  /** 1 when the FAQ is the whole page (/faq), so its title is the page's
   *  h1; 2 (default) when it's a section of the homepage. Same look either
   *  way — the class carries the style, not the tag. */
  level?: 1 | 2;
}

const { level = 2 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';

const FAQS: { q: string; a: string[] }[] = [
  {
    q: 'Where is STAND?',
    a: [
      'Our first space is in Santa Monica, opening January 11, 2027. We’d love to bring STAND to more cities soon.',
    ],
  },
  {
    q: 'Who is STAND for?',
    a: [
      'Kids ages 8 to 13 who love to make, build, and create, and want to do it alongside other kids. They don’t need an idea to start. Finding one is part of the fun.',
    ],
  },
  {
    q: 'What can I expect?',
    a: [
      'It feels more like a workshop than a classroom. Lots of making, testing, and changing their minds, all while building something that’s truly theirs.',
      'Over eight weeks, they take an idea from first spark to brand, product, pricing, marketing, and a final pitch.',
    ],
  },
  {
    q: 'What will my kid leave with?',
    a: [
      'Something they built themselves, and the confidence that they can figure things out on their own. They’ll also take home their brand and business plan.',
    ],
  },
  {
    q: 'What kinds of skills will they learn?',
    a: [
      'Entrepreneurship is the vehicle. Everything they learn along the way is the point.',
      'Creativity, talking about their ideas, handling money, making decisions, and sticking with something when it gets hard.',
    ],
  },
  {
    q: 'Who teaches STAND?',
    a: [
      'People who know what it means to build something real. STAND brings together entrepreneurs, makers, creatives, and mentors to help kids build their own thing.',
    ],
  },
  {
    q: 'When does it start?',
    a: [
      `Our first cohorts start January 11, 2027. <a href="${ENROLL_HREF}">Enroll now</a> to save your child’s spot. We’d love to meet them.`,
    ],
  },
  {
    q: 'What is the cancellation policy?',
    a: [
      'Plans change, and we get it. Our <a href="/cancellation-policy">Cancellation and Refund Policy</a> has all the details.',
    ],
  },
];
---

<section class="fc-faq" id="faq" aria-labelledby="faq-title">
  <Heading id="faq-title" class="headline-xl">FAQ</Heading>

  <div class="list">
    {
      FAQS.map(({ q, a }) => (
        <details>
          <summary>
            <span>{q}</span>
            <span class="mark" aria-hidden="true">+</span>
          </summary>
          <div class="desc">
            {a.map((para) => (
              <p set:html={para} />
            ))}
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .fc-faq {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    /* Same 1132px column + 48px gutters as the manifesto. */
    max-width: calc(1132px + 2 * 48px);
    margin: 0 auto;
    padding: var(--space-7) 48px;
  }

  .headline-xl {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(30px, 3.6vw, 52px);
    line-height: 1.04;
    letter-spacing: 0.02em;
    /* Acronym exception to the Title Case display rule (JY, Aug 25): FAQ
       stays all-caps; running words in Pie Pie get capitalize. */
    text-transform: uppercase;
  }

  .list {
    display: flex;
    flex-direction: column;
  }

  details {
    border-bottom: 1px solid var(--stand-black);
  }

  details:first-child {
    border-top: 1px solid var(--stand-black);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 22px 0;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 22px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 2px solid var(--stand-red);
    outline-offset: 4px;
  }

  .mark {
    font-weight: 400;
    font-size: 28px;
    line-height: 1;
    color: var(--stand-red);
    transition: transform 160ms ease;
  }

  details[open] .mark {
    transform: rotate(45deg);
  }

  details .desc {
    margin: 0;
    padding: 0 0 22px;
    max-width: 62ch;
  }

  details .desc p {
    margin: 0;
  }

  /* set:html content doesn't carry Astro's scope class, hence :global. The
     global reset strips underlines; answer links need them back. */
  details .desc :global(a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  details .desc :global(a:hover),
  details .desc :global(a:focus-visible) {
    color: var(--stand-red);
    text-decoration-thickness: 2px;
  }

  details .desc p + p {
    margin-top: 12px;
  }

  @media (max-width: 768px) {
    .fc-faq {
      padding: var(--space-6) var(--space-3);
    }

    summary {
      font-size: 18px;
      padding: 18px 0;
    }
  }

  /* <details> snaps open with no bridge; a short entrance settles the
     answer in. Entrance-only — collapse stays instant. */
  details[open] .desc {
    animation: fc-faq-reveal 220ms ease-out;
  }

  @keyframes fc-faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    details[open] .desc {
      animation: none;
    }
  }
</style>
