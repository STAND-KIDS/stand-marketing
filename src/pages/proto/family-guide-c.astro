---
// Proto C: editorial Family Guide.
// Concept: one red poster hero, then a calm cream page (JY, Nov 26: no
// object cut-outs, far fewer colour fields), set in oversized Pie Pie
// headlines over tight Authentic Sans body, with the
// welcome note and the five values in Editorial New. A fixed index
// (scroll-spy, left rail on desktop, bottom jump bar on phones) tracks the
// section under the viewport. All copy comes from src/data/family-guide.ts.
//
// Progressive enhancement: with JS off the page is a static stack of colour
// fields (index hidden). Scroll-driven reveals are CSS-only, gated by
// @supports(animation-timeline) and prefers-reduced-motion: no-preference.
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/founders/Nav.astro';
import Closing from '@/components/founders/Closing.astro';
import { GUIDE, GUIDE_TITLE } from '@/data/family-guide';

// Ground per section id. Everything is cream: the red hero and red footer
// are the page's only colour. Add an id here to give a section its own
// field. 'cream' sections carry data-nav-cream so the nav stays legible.
const GROUNDS: Record<string, string> = {};

const words = GUIDE_TITLE.split(' ');
---

<Layout title="Proto C — Family Guide | STAND" noindex>
  <script is:inline>
    document.documentElement.classList.add('fg-js');
  </script>

  <Nav tabs={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about' }]} />

  <main class="fg">
    <header class="fg-hero" data-ground="red">
      <h1 class="fg-title">
        {words.map((w) => <span class="fg-title-word">{w}</span>)}
      </h1>
    </header>

    {/* Index: hidden without JS. Desktop = fixed left rail; phones = bottom jump bar. */}
    <nav class="fg-index" aria-label={GUIDE_TITLE} data-tone="light">
      <button class="fg-index-btn" type="button" aria-expanded="false" aria-controls="fg-index-list">
        <span class="fg-index-current">{GUIDE_TITLE}</span>
        <svg viewBox="0 0 12 8" width="14" height="10" aria-hidden="true"><path d="M1 7l5-5 5 5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
      </button>
      <ul class="fg-index-list" id="fg-index-list">
        {GUIDE.map((s) => (
          <li><a href={`#${s.id}`} data-spy={s.id}>{s.title}</a></li>
        ))}
      </ul>
    </nav>

    {
      GUIDE.map((section, i) => {
        const ground = GROUNDS[section.id] ?? 'cream';
        const first = section.id === 'welcome';
        const values = section.id === 'values';
        return (
          <section
            class:list={['fg-sec', `fg-${section.id}`, i % 2 ? 'is-flip' : '']}
            id={section.id}
            aria-labelledby={`${section.id}-h`}
            data-ground={ground}
            data-nav-cream={ground === 'cream' ? '' : undefined}
          >
            <div class="fg-sec-inner">
              <h2 class="fg-h2" id={`${section.id}-h`}>{section.title}</h2>
              <div class:list={['fg-body', first && 'is-note', values && 'is-values']}>
                {section.blocks.map((block, bi) =>
                  block.kind === 'p' ? (
                    <p class:list={[(first || bi === 0) && 'fg-lede']}>
                      {block.lead && <strong>{block.lead} </strong>}
                      <Fragment set:html={block.html} />
                    </p>
                  ) : block.kind === 'list' ? (
                    <ul class="fg-list">
                      {block.items.map((item) => (
                        <li>
                          {item.lead && <strong class="fg-item-lead">{item.lead} </strong>}
                          <Fragment set:html={item.html} />
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="fg-signoff">
                      <strong>{block.name}</strong>
                      <span>{block.role}</span>
                    </p>
                  ),
                )}
              </div>
            </div>
          </section>
        );
      })
    }
  </main>

  <Closing />
</Layout>

<style is:global>
  .fg {
    --fg-gutter: 20px;
    --fg-rail: 0px;
    position: relative;
  }

  /* Colour fields: each ground sets bg + readable fg + link colour. */
  .fg [data-ground='cream'] { --bg: var(--stand-cream); --fg: var(--stand-black); --accent: var(--stand-red); }
  .fg [data-ground='red'] { --bg: var(--stand-red); --fg: var(--stand-white); --accent: var(--stand-cream); }
  .fg [data-ground='green'] { --bg: var(--stand-green); --fg: var(--stand-cream); --accent: var(--stand-mustard); }
  .fg [data-ground='mustard'] { --bg: var(--stand-mustard); --fg: var(--stand-black); --accent: var(--stand-red); }
  .fg [data-ground='blue'] { --bg: var(--stand-blue); --fg: var(--stand-cream); --accent: var(--stand-mustard); }
  .fg [data-ground='black'] { --bg: var(--stand-black); --fg: var(--stand-cream); --accent: var(--stand-mustard); }
  .fg [data-ground] { background: var(--bg); color: var(--fg); }

  .fg a { color: inherit; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.2em; }
  .fg a:hover { text-decoration-color: var(--accent); }
  .fg a:focus-visible, .fg button:focus-visible { outline: 3px solid currentColor; outline-offset: 3px; }

  /* Hero */
  .fg-hero {
    position: relative;
    overflow: hidden;
    min-height: 72svh;
    padding: calc(var(--header-h) + 40px) var(--fg-gutter) 48px;
    display: flex;
    align-items: flex-end;
    color: var(--stand-cream) !important;
  }
  .fg-title {
    position: relative;
    z-index: 2;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: min(300px, calc((100vw - 2 * var(--fg-gutter) - var(--fg-rail)) / 4.8));
    line-height: 0.82;
    letter-spacing: -0.01em;
    max-width: 100%;
  }
  .fg-title-word { display: block; }

  /* Sections */
  .fg-sec {
    position: relative;
    overflow: hidden;
    scroll-margin-top: var(--header-h);
    padding: 72px var(--fg-gutter) 88px;
  }
  .fg-sec-inner { position: relative; z-index: 2; max-width: 1180px; margin: 0 auto; }

  .fg-h2 {
    margin: 0 0 32px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 12vw, 132px);
    line-height: 0.92;
    letter-spacing: -0.005em;
    text-wrap: balance;
    max-width: 14ch;
  }

  .fg-body { max-width: 62ch; font-size: 18px; line-height: 1.55; }
  .fg-body p { margin: 0 0 1em; }
  .fg-body > :last-child { margin-bottom: 0; }
  .fg-body strong { font-weight: 700; }

  .fg-lede { font-size: 21px; line-height: 1.45; font-weight: 400; }

  /* Welcome note + values: Editorial New, large. */
  .fg-body.is-note { max-width: 24em; }
  .fg-body.is-note .fg-lede,
  .fg-body.is-note p {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(26px, 5.4vw, 46px);
    line-height: 1.18;
  }
  .fg-signoff { display: flex; flex-direction: column; gap: 2px; margin-top: 1.5em !important; font-family: var(--font-sans); font-size: 18px; }
  .fg-body.is-note .fg-signoff { font-family: var(--font-sans); font-size: 18px; line-height: 1.3; }
  .fg-signoff strong { font-size: 22px; }

  /* Lists: simple bullets, hanging indent, no rules. */
  .fg-list { margin: 0 0 1em; padding: 0 0 0 1.25em; list-style: disc; }
  .fg-list li { margin: 0 0 0.7em; padding-left: 0.25em; }
  .fg-list li::marker { color: var(--accent); }

  .fg-body.is-values { max-width: 44em; }
  .fg-body.is-values .fg-lede { font-size: 21px; }
  .fg-body.is-values .fg-list { padding-left: 0.7em; }
  .fg-body.is-values .fg-list li { margin-bottom: 1.1em; }
  .fg-body.is-values .fg-item-lead {
    display: block;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(36px, 8.6vw, 76px);
    line-height: 1;
    margin-bottom: 0.15em;
  }


  /* Index */
  .fg-index { display: none; }
  .fg-js .fg-index {
    display: block;
    position: fixed;
    z-index: 40;
    left: 0; right: 0; bottom: 0;
    background: var(--stand-cream);
    color: var(--stand-black);
    border-top: 2px solid var(--stand-black);
    transition: transform 0.3s ease;
  }
  .fg-index.is-away { transform: translateY(110%); }
  .fg-index-btn {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    width: 100%; min-height: 52px; padding: 0 var(--fg-gutter);
    background: none; border: 0; color: inherit; cursor: pointer;
    font: 700 17px/1.2 var(--font-sans); text-align: left;
  }
  .fg-index-btn svg { flex: none; transition: transform 0.2s ease; }
  .fg-index-btn[aria-expanded='true'] svg { transform: rotate(180deg); }
  .fg-index-list {
    display: none; list-style: none; margin: 0; padding: 0 var(--fg-gutter) 12px;
    max-height: 60svh; overflow: auto;
  }
  .fg-index-btn[aria-expanded='true'] + .fg-index-list { display: block; }
  .fg-index-list a {
    display: flex; align-items: center; min-height: 44px; text-decoration: none;
    font-size: 17px; line-height: 1.25;
  }
  .fg-index-list a[aria-current='true'] { font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; }

  @media (min-width: 640px) {
    .fg { --fg-gutter: 32px; }
    .fg-body { font-size: 19px; }
    .fg-lede { font-size: 24px; }
    .fg-body.is-values .fg-lede { font-size: 24px; }
  }

  /* Desktop: fixed left rail that reads on whichever field is behind it. */
  @media (min-width: 1100px) {
    .fg { --fg-gutter: 48px; --fg-rail: 280px; }
    .fg-sec, .fg-hero { padding-left: calc(var(--fg-gutter) + var(--fg-rail)); padding-right: var(--fg-gutter); }
    .fg-sec { padding-top: 120px; padding-bottom: 140px; }
    .fg-sec-inner { margin: 0; max-width: none; }
    .fg-h2 { margin-bottom: 56px; max-width: 12ch; }
    .fg-body { margin-left: 18%; }
    .fg-sec.is-flip .fg-body { margin-left: 0; }
    .fg-sec.is-flip .fg-h2 { margin-left: 22%; }
    .fg-body.is-note, .fg-body.is-values { margin-left: 0; }

    .fg-js .fg-index {
      left: 0; right: auto; top: calc(var(--header-h) + 40px); bottom: auto;
      width: 280px; background: none; border: 0; color: var(--stand-black);
      padding: 0 0 0 var(--fg-gutter);
      transition: color 0.3s ease, opacity 0.3s ease;
    }
    .fg-index.is-away { transform: none; opacity: 0; pointer-events: none; }
    .fg-index[data-tone='dark'] { color: var(--stand-cream); }
    .fg-index-btn { display: none; }
    .fg-index-list { display: block !important; padding: 0; max-height: none; overflow: visible; }
    .fg-index-list a { min-height: 44px; font-size: 16px; padding-left: 20px; position: relative; }
    .fg-index-list a[aria-current='true'] { text-decoration: none; font-weight: 700; }
    .fg-index-list a[aria-current='true']::before {
      content: ''; position: absolute; left: 0; top: 50%; width: 10px; height: 10px; margin-top: -5px;
      border-radius: 50%; background: currentColor;
    }
  }

  /* Anchors land under the fixed nav (index is fixed, content never hides under it on desktop). */
  @media (max-width: 1099px) {
    .fg-sec:last-of-type { padding-bottom: 120px; }
  }

  /* Scroll-driven motion: only where supported AND motion is welcome. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      @keyframes fg-rise { from { opacity: 0; transform: translateY(48px); } to { opacity: 1; transform: none; } }

      .fg-h2, .fg-body > *, .fg-list li {
        animation: fg-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 55%;
      }
    }
  }
</style>

<script>
  // Scroll-spy: highlight the section crossing the middle of the viewport,
  // flip the rail's tone by that section's ground, hide the bar over the
  // hero and footer. Pure IntersectionObserver, no scroll listeners.
  const index = document.querySelector<HTMLElement>('.fg-index');
  const btn = document.querySelector<HTMLButtonElement>('.fg-index-btn');
  const label = document.querySelector<HTMLElement>('.fg-index-current');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-spy]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.fg-sec'));
  const hero = document.querySelector<HTMLElement>('.fg-hero');
  const closing = document.querySelector<HTMLElement>('.fc-closing');
  const base = label?.textContent ?? '';
  const dark = new Set(['red', 'green', 'blue', 'black']);

  if (index) {
    const setActive = (el: HTMLElement | null) => {
      links.forEach((a) => {
        const on = !!el && a.dataset.spy === el.id;
        if (on) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
      if (label) label.textContent = el ? (el.querySelector('h2')?.textContent ?? base) : base;
      index.dataset.tone = el && dark.has(el.dataset.ground ?? '') ? 'dark' : 'light';
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) setActive(e.target as HTMLElement);
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));

    // Rail tone while over the hero (red = dark), and away-state over hero/footer.
    const away = new Set<Element>();
    const io2 = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) away.add(e.target);
          else away.delete(e.target);
        }
        const overHero = hero ? away.has(hero) : false;
        const overClosing = closing ? away.has(closing) : false;
        index.classList.toggle('is-away', overClosing || (overHero && matchMedia('(max-width: 1099px)').matches));
        if (overHero) setActive(null), (index.dataset.tone = 'dark');
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    if (hero) io2.observe(hero);
    if (closing) io2.observe(closing);

    btn?.addEventListener('click', () => {
      btn.setAttribute('aria-expanded', String(btn.getAttribute('aria-expanded') !== 'true'));
    });
    index.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) btn?.setAttribute('aria-expanded', 'false');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') btn?.setAttribute('aria-expanded', 'false');
    });
  }
</script>
