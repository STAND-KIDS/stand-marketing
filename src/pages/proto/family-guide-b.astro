---
// Proto B — Family Guide in the homepage's own design language: full-bleed
// brand-ground bands, Pie Pie headlines, Editorial New statement lines,
// data-rv chunk reveals, Nav + Closing chrome. Copy comes only from
// src/data/family-guide.ts.
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/founders/Nav.astro';
import Closing from '@/components/founders/Closing.astro';
import { GUIDE, GUIDE_TITLE } from '@/data/family-guide';

// Per-section ground + whether the first paragraph is set as a big serif
// statement line. Cream everywhere with one green band for the values (JY,
// Nov 26: no object illustrations, far fewer colour bands). The red nav and
// red footer already carry the brand colour.
// `callout` sets that statement on the paper-tag sticker (JY, Nov 26).
// Welcome stays plain: it's a letter, signed by Lauren.
const LOOK: Record<string, { ground: string; statement?: boolean; callout?: boolean }> = {
  welcome: { ground: 'cream', statement: true },
  'what-stand-is': { ground: 'cream', statement: true, callout: true },
  values: { ground: 'green' },
  'when-things-go-sideways': { ground: 'cream', statement: true, callout: true },
};
---

<Layout title="Proto B — Family Guide | STAND" noindex>
  <main class="founders-page fg">
    <Nav
      tabs={[
        { label: 'Home', href: '/' },
        { label: 'About', href: '/about' },
      ]}
    />

    <header class="fg-hero" data-nav-cream>
      <h1 class="headline-xl">{GUIDE_TITLE}</h1>
    </header>

    {
      GUIDE.map((section) => {
        const look = LOOK[section.id] ?? { ground: 'cream' };
        const firstP = section.blocks.findIndex((b) => b.kind === 'p');
        return (
          <section
            class={`band ${look.ground}`}
            id={section.id}
            aria-labelledby={`${section.id}-title`}
            data-nav-cream={look.ground === 'cream' ? '' : undefined}
          >
            <div class="inner">
              <div class="side" data-rv style="--rvi: 0">
                <h2 class="headline-xl" id={`${section.id}-title`}>{section.title}</h2>
              </div>
              <div class="body">
                {section.blocks.map((block, i) =>
                  block.kind === 'p' ? (
                    <p class:list={[{ statement: look.statement && i === firstP, callout: look.callout && i === firstP }]} data-rv style={`--rvi: ${Math.min(i + 1, 4)}`}>
                      {block.lead && <strong>{block.lead} </strong>}
                      <Fragment set:html={block.html} />
                    </p>
                  ) : block.kind === 'list' ? (
                    <ul data-rv style={`--rvi: ${Math.min(i + 1, 4)}`}>
                      {block.items.map((item) => (
                        <li>
                          {item.lead && <strong>{item.lead} </strong>}
                          <Fragment set:html={item.html} />
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="signoff" data-rv style={`--rvi: ${Math.min(i + 1, 4)}`}>
                      <span class="name-line">{block.name}</span>
                      <span class="role">{block.role}</span>
                    </p>
                  ),
                )}
              </div>
            </div>
          </section>
        );
      })
    }

    <Closing />
  </main>
</Layout>

<style is:global>
  .fg [id] {
    scroll-margin-top: 84px;
  }

  .fg .headline-xl {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    /* Homepage scale (Nov 26): same as the FAQ headline in Faq.astro. */
    font-size: clamp(30px, 3.6vw, 52px);
    line-height: 1.04;
    letter-spacing: 0.02em;
    text-wrap: balance;
  }

  /* Hero: the cream page ground and the title. No jump list (JY, Nov 26):
     the homepage has none, and every section keeps its anchor id. */
  .fg-hero {
    padding: 140px 48px 24px;
    max-width: calc(1132px + 2 * 48px);
    margin: 0 auto;
  }
  .fg-hero .headline-xl {
    /* The homepage's largest headline size (NewSpace .mega). */
    font-size: clamp(36px, 5.2vw, 75px);
    line-height: 1.02;
  }

  /* Bands */
  .fg .band {
    /* Two-thirds of the first pass (JY, Nov 26: section gaps read too big
       on a laptop). Phones keep var(--space-5) below. */
    padding: clamp(37px, 5.33vw, 75px) 48px;
  }
  .fg .band.cream { background: var(--stand-cream); color: var(--stand-black); }
  .fg .band.red { background: var(--stand-red); color: var(--stand-cream); }
  .fg .band.green { background: var(--stand-green); color: var(--stand-cream); }
  .fg .band.mustard { background: var(--stand-mustard); color: var(--stand-black); }
  .fg .band.pink { background: var(--stand-pink); color: var(--stand-black); }
  /* The hero is cream, welcome continues it without a seam. */
  .fg-hero + .band.cream { padding-top: clamp(24px, 3vw, 40px); }

  .fg .inner {
    max-width: calc(1132px);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    column-gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .fg .side {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .fg .body {
    max-width: 65ch;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .fg .body p,
  .fg .body li {
    margin: 0;
    /* Homepage body size (Location .para). */
    font-size: clamp(17px, 1.8vw, 24px);
    line-height: 1.4;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }
  .fg .body strong { font-weight: 700; }
  .fg .body a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1.5px;
    display: inline-block;
    min-height: 44px;
    line-height: 44px;
    padding: 0 2px;
    margin: 0 -2px;
  }
  .fg .body a:hover { text-decoration-thickness: 3px; }
  /* Keep inline links from inflating line height in running text. */
  .fg .body p a { line-height: inherit; min-height: 0; display: inline; padding: 0; margin: 0; }
  .fg .body p a { padding-block: 12px; background-clip: padding-box; }

  .fg .body .statement {
    font-family: var(--font-serif);
    font-weight: 300;
    /* 36px on a laptop (JY, Nov 26: the testimonial-quote size, 46px at
       1440, read too big here). Phones stay at 26px. */
    font-size: clamp(26px, 2.5vw, 36px);
    line-height: 1.18;
    letter-spacing: -0.01em;
  }

  /* Callout: the site's paper-tag sticker (SignupButton.astro), same
     values: white face, 2px black border, hard 5px offset shadow, -5deg
     skew. The sticker is a ::before layer so the skew stays off the serif
     type. On desktop it bleeds out by its padding so the text keeps the
     body's left edge; on phones it sits inside the gutter, leaving room
     for the skew and shadow. */
  .fg .body .callout {
    --pad-x: clamp(20px, 2.6vw, 40px);
    position: relative;
    isolation: isolate;
    padding: clamp(20px, 2.4vw, 36px) var(--pad-x);
    margin-inline: calc(-1 * var(--pad-x));
    color: var(--stand-black);
  }
  .fg .body .callout::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--stand-white);
    border: 2px solid var(--stand-black);
    box-shadow: 5px 5px 0 var(--stand-black);
    transform: skewX(-5deg);
  }
  @media (max-width: 768px) {
    .fg .body .callout {
      margin-inline: 4px 10px;
    }
  }

  .fg .body ul {
    margin: 0;
    padding: 0 0 0 1.25em;
    list-style: disc;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .fg .body li::marker { font-size: 1em; }

  .fg .signoff {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 6px;
  }
  .fg .signoff .name-line {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.1;
  }

  /* Chunk reveals — same recipe as the homepage. */
  .rv-ready [data-rv] {
    opacity: 0;
    transform: translateY(28px);
    filter: blur(2px);
    transition:
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.5s ease;
    transition-delay: calc(var(--rvi, 0) * 180ms);
  }
  .rv-shown [data-rv] {
    opacity: 1;
    transform: none;
    filter: blur(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .rv-ready [data-rv] {
      transition: none !important;
    }
  }

  @media (max-width: 900px) {
    .fg .inner {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 28px;
    }
  }
  @media (max-width: 768px) {
    .fg-hero { padding: 108px 20px 16px; }
    .fg .band { padding: var(--space-5) 20px; }
    .fg-hero + .band.cream { padding-top: 24px; }
  }
</style>

<script>
  import Lenis from 'lenis';

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const lenis = new Lenis({ lerp: 0.1, anchors: true });
    const raf = (time: number) => {
      lenis.raf(time);
      requestAnimationFrame(raf);
    };
    requestAnimationFrame(raf);
  }

  if ('IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('.founders-page section').forEach((sec) => {
      if (!sec.querySelector('[data-rv]')) return;
      sec.classList.add('rv-ready');
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            sec.classList.add('rv-shown');
            io.disconnect();
          }
        },
        { threshold: 0.12 },
      );
      io.observe(sec);
    });
  }
</script>
